<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MicrosoftGraph</RootNamespace>
  </PropertyGroup>

  <!-- NativeAOT shared library (ARCHITECTURE.md 10). Applied on publish; inert during `dotnet build`. -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Surfaces AOT/trim violations as build warnings on Windows, where no native linker exists. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Not packable. Every type here is internal, and the only consumer is the Python wheel, which
       loads the natively compiled library rather than referencing this assembly. A NuGet package
       would ship a DLL with no public API at all. See ARCHITECTURE.md §2. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Graph.Core" Version="4.0.1" />
    <!-- Already transitive via Azure.Identity, so this adds no package to the graph. Needed
         directly because Azure.Identity exposes no PKCE code verifier (ARCHITECTURE.md 10). -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.83.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTests" />
    <InternalsVisibleTo Include="IntegrationTests" />
  </ItemGroup>

</Project>
